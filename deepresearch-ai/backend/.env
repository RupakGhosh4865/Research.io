# ============================================
# DeepResearch AI — Backend Environment Variables
# ============================================

# OpenAI
OPENAI_API_KEY=sk-...          # Get from: platform.openai.com/api-keys

# LangSmith (for agent tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...      # Get from: smith.langchain.com
LANGCHAIN_PROJECT=deepresearch-ai

# Tavily Search API
TAVILY_API_KEY=tvly-...        # Get from: tavily.com/dashboard

# Pinecone Vector DB
PINECONE_API_KEY=pcsk_...      # Get from: app.pinecone.io
PINECONE_INDEX_NAME=deepresearch
PINECONE_ENVIRONMENT=us-east-1

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=redis://default:[token]@[host].upstash.io:6379

# Clerk (Auth) - for backend JWT verification
CLERK_SECRET_KEY=sk_test_...   # Get from: clerk.com/dashboard
CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...  # Get from: stripe.com/dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
